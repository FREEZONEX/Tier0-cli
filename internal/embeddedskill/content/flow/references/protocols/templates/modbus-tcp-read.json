[
  {
    "id": "tab_{{FLOW_ID}}",
    "type": "tab",
    "label": "{{FLOW_NAME}}",
    "disabled": false,
    "info": "Modbus TCP read → function → MQTT/UNS. Generated by Tier0 CLI template."
  },
  {
    "id": "modbus_client_{{FLOW_ID}}",
    "type": "modbus-client",
    "name": "{{DEVICE_NAME}}",
    "clienttype": "tcp",
    "bufferCommands": true,
    "stateLogEnabled": false,
    "queueLogEnabled": false,
    "failureLogEnabled": true,
    "tcpHost": "{{MODBUS_HOST}}",
    "tcpPort": 502,
    "tcpType": "DEFAULT",
    "serialPort": "/dev/ttyUSB",
    "serialType": "RTU-BUFFERD",
    "serialBaudrate": 9600,
    "serialDatabits": 8,
    "serialStopbits": 1,
    "serialParity": "none",
    "serialConnectionDelay": 100,
    "serialAsciiResponseStartDelimiter": "0x3A",
    "unit_id": 1,
    "commandDelay": 1,
    "clientTimeout": 1000,
    "reconnectOnTimeout": true,
    "reconnectTimeout": 2000,
    "parallelUnitIdsAllowed": true,
    "showErrors": false,
    "showWarnings": true,
    "showLogs": true
  },
  {
    "id": "modbus_read_{{FLOW_ID}}",
    "type": "modbus-read",
    "z": "tab_{{FLOW_ID}}",
    "name": "{{READ_NODE_NAME}}",
    "topic": "",
    "showStatusActivities": false,
    "logIOActivities": false,
    "showErrors": false,
    "showWarnings": true,
    "unitid": "",
    "dataType": "{{DATA_TYPE}}",
    "adr": "{{START_ADDRESS}}",
    "quantity": "{{QUANTITY}}",
    "rate": "{{POLL_RATE}}",
    "rateUnit": "{{POLL_RATE_UNIT}}",
    "delayOnStart": false,
    "startDelayTime": "",
    "server": "modbus_client_{{FLOW_ID}}",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "emptyMsgOnFail": false,
    "x": 200,
    "y": 160,
    "wires": [
      ["function_{{FLOW_ID}}"],
      []
    ]
  },
  {
    "id": "function_{{FLOW_ID}}",
    "type": "function",
    "z": "tab_{{FLOW_ID}}",
    "name": "Map to UNS payload",
    "func": "// msg.payload.data is the Modbus register/coil array.\nvar registers = Array.isArray(msg.payload) ? msg.payload : msg.payload && msg.payload.data;\nif (!Array.isArray(registers) || registers.length === 0) return null;\n\n// TODO: replace this mapping with the target UNS topic fields.\nvar value = { value: Number(registers[0]) };\n\nmsg.topic = \"{{UNS_TOPIC}}\";\nmsg.payload = JSON.stringify(value);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 160,
    "wires": [
      ["mqtt_out_{{FLOW_ID}}"]
    ]
  },
  {
    "id": "mqtt_out_{{FLOW_ID}}",
    "type": "mqtt out",
    "z": "tab_{{FLOW_ID}}",
    "name": "Publish to UNS",
    "topic": "{{UNS_TOPIC}}",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "{{TIER0_MQTT_BROKER_ID}}",
    "x": 660,
    "y": 160,
    "wires": []
  },
  {
    "id": "modbus_response_{{FLOW_ID}}",
