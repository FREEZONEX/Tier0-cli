  {
    "id": "function_{{FLOW_ID}}",
    "type": "function",
    "z": "tab_{{FLOW_ID}}",
    "name": "Build INSERT",
    "func": "// Normalize the UNS VQT message.\nvar payload = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\nvar value = payload && payload.value !== undefined ? payload.value : payload;\nvar quality = payload && payload.quality ? payload.quality : \"Good\";\nvar ts = payload && payload.timeStamp ? new Date(payload.timeStamp) : new Date();\n\nmsg.params = [msg.topic, JSON.stringify(value), quality, ts.toISOString()];\nmsg.query = \"INSERT INTO uns_values(topic, value, quality, ts) VALUES ($1, $2::jsonb, $3, $4::timestamptz)\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
